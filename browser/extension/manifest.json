{
  "manifest_version": 3,
  "name": "TermVault — локальное заполнение",
  "version": "0.1.4",
  "description": "Заполняет логин и пароль по нажатию с подтверждением в локальном TermVault. Экспериментальная версия.",
  "minimum_chrome_version": "106",
  "permissions": ["activeTab", "scripting", "nativeMessaging"],
  "background": { "service_worker": "background.js", "type": "module" },
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": { "default_title": "TermVault: заполнить с подтверждением", "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" } },
  "incognito": "not_allowed",
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'" }
}
